export type UiPath = keyof typeof UI_PROCEDURES;
export type UiQueryPath = { [P in UiPath]: (typeof UI_PROCEDURES)[P] extends 'query' ? P : never }[UiPath];
export type UiMutationPath = { [P in UiPath]: (typeof UI_PROCEDURES)[P] extends 'mutation' ? P : never }[UiPath];

export function isUiPath(value: unknown): value is UiPath {
  return typeof value === 'string' && Object.hasOwn(UI_PROCEDURES, value);
}
