{
  "name": "@agent-board/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./router": "./src/trpc/router.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "test": "vitest --run",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@agent-board/shared": "workspace:*",
    "@electric-sql/pglite": "^0.5.16",
    "@trpc/server": "11.25.0",
    "croner": "^11.0.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
